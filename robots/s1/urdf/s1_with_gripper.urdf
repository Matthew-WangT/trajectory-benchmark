<?xml version="1.0"?>
<!-- Astribot S1 with F90C grippers, from mindon_robotics assets/resource/robot/s1/urdf/serial_s1_with_gripper.urdf
     (xacro astribot_s1_whole_body_with_wheel.xacro). Changes, see robots/s1/README.md:
     - mesh paths relative to this file;
     - torso and arm joint limits: the intersection of this model and the SDK astribot_whole_body.urdf and
       astribot_{torso,arm_left,arm_right}.urdf;
     - root benchmark_base, the BASE of the trajectories, translation only: the shoulder midpoint (joint 1 of both
       arms) at the startup pose q_pd lies at (0.1, 0, 1.121), 0.1 m ahead of the Marvin shoulder midpoint
       (0, 0, 1.121), so that the trajectories come 0.1 m closer to the robot (x pulled back by 0.1 m). -->
<robot name="astribot_whole_body">
  <link name="benchmark_base"/>
  <joint name="benchmark_base_to_torso_base" type="fixed">
    <origin rpy="0 0 0" xyz="0.10286 0 -0.13620"/>
    <parent link="benchmark_base"/>
    <child link="astribot_torso_base"/>
  </joint>
  <link name="astribot_torso_base">
