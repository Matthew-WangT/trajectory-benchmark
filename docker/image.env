# The two images of docker/Dockerfile, one repository with a tag each: docker/run.sh pulls them, docker/image.sh
# builds and publishes them. Bump VERSION with every change of the Dockerfile, then
# docker/image.sh build && docker/image.sh push.
REGISTRY=crpi-6ozp4o0383po5yjl.cn-shenzhen.personal.cr.aliyuncs.com/ice_room
VERSION=v1.1
BASE_IMAGE=$REGISTRY/eef-trajectory-benchmark:$VERSION
S1_IMAGE=$REGISTRY/eef-trajectory-benchmark:$VERSION-s1
